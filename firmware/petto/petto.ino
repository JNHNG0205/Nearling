// QR (ricmoo QRCode), version chosen by byte capacity at ECC_LOW
QRCode qr;
uint8_t qrBuf[512];
String qrText;
bool qrOk = false;
void drawQR(Adafruit_GFX &g, const String &text, int cx, int cy, int maxPx) {
  static const uint16_t cap[] = {0, 17, 32, 53, 78, 106, 134, 154, 192, 230, 271};
  if (text != qrText) {
    qrText = text; qrOk = false;
    for (int v = 1; v <= 10; v++)
      if (text.length() <= cap[v]) { qrOk = qrcode_initText(&qr, qrBuf, v, ECC_LOW, text.c_str()) == 0; break; }
  }
  if (!qrOk) { textCenter(g, "link too long for QR", cy, 1, C_RED); return; }
  int n = qr.size, s = max(1, maxPx / (n + 4)), full = (n + 4) * s;
  int x0 = cx - full / 2, y0 = cy - full / 2;
  g.fillRect(x0, y0, full, full, C_WHITE);
  for (int y = 0; y < n; y++)
    for (int x = 0; x < n; x++)
      if (qrcode_getModule(&qr, x, y)) g.fillRect(x0 + (x + 2) * s, y0 + (y + 2) * s, s, s, C_BLACK);
}

// ---- pet sprites ----
const nl_clip_t *onceClip = nullptr;
uint32_t onceStart = 0;
String loopKey;
uint32_t loopStart = 0;

const nl_clip_t *pickClip(const char *name, const Pet &p) {
  bool egg = !p.hatched || p.stage == 0;
  uint8_t stage = egg ? 0 : p.stage;
  if (egg && strncmp(name, "egg_", 4) != 0) name = "egg_idle";
  uint8_t pers = nl_personality(p.traits);
  const nl_clip_t *c = nl_find_clip(name, stage, p.winged ? 1 : 0, pers);
  if (!c) c = nl_find_clip(egg ? "egg_idle" : "idle", stage, p.winged ? 1 : 0, pers);
  return c;
}
void playOnce(const char *name, const Pet &p) {
  const nl_clip_t *c = pickClip(name, p);
  if (c) { onceClip = c; onceStart = millis(); }
}
// One 32x32 4 bpp layer, scaled by s; colour indices above maxIdx are skipped.
void blitLayer(const uint8_t *f, const uint16_t *pal, uint8_t maxIdx, int x0, int y0, int s) {
  uint16_t *fb = cv->getBuffer();
  for (int y = 0; y < NL_SPRITE_SIZE; y++)
    for (int x = 0; x < NL_SPRITE_SIZE; x++) {
      uint8_t b = f[(y * NL_SPRITE_SIZE + x) >> 1];
      uint8_t i = (x & 1) ? (b & 0x0F) : (b >> 4);
      if (!i || i > maxIdx) continue;
      uint16_t col = pal[i];
      for (int dy = 0; dy < s; dy++) {
        int py = y0 + y * s + dy;
        if (py < 0 || py >= TFT_H) continue;
        for (int dx = 0; dx < s; dx++) {
          int px = x0 + x * s + dx;
          if (px >= 0 && px < TFT_W) fb[py * TFT_W + px] = col;
        }
      }
    }
}
// Same order as the web (toRgba): costume back, pet, shirt, costume front. Back drawn first and
// covered by the pet and shirt = "back only where the pet is clear".
void drawClipFrame(const nl_clip_t *c, int idx, const Pet &p, int x0, int y0, int s) {
  if (!c || !cv) return;
  uint16_t pal[16], shirtPal[4];
  nl_build_palette(p.traits, c->grey, pal);
  uint16_t back = NL_COSTUME_NONE, front = NL_COSTUME_NONE;
  int ci = c - NL_CLIPS;
  if (costumesOk && p.costume >= 0 && NL_COSTUME_CLIP_OFS[ci] != NL_COSTUME_NONE) {
    const uint16_t *r = NL_COSTUME_REF + ((uint32_t)p.costume * NL_COSTUME_FRAME_REFS + NL_COSTUME_CLIP_OFS[ci] + idx) * 2;
    back = r[0]; front = r[1];
  }
  if (back != NL_COSTUME_NONE) blitLayer(nl_costume_layer(back), NL_COSTUME_PALETTE, 15, x0, y0, s);
  blitLayer(nl_frame(c->frames[idx]), pal, 15, x0, y0, s);
  if (c->shirt && p.shirt.length()) {
    nl_build_shirt_palette(p.shirt.c_str(), c->grey, shirtPal);
    blitLayer(nl_frame(c->shirt[idx]), shirtPal, 3, x0, y0, s);
  }
  if (front != NL_COSTUME_NONE) blitLayer(nl_costume_layer(front), NL_COSTUME_PALETTE, 15, x0, y0, s);
}
// Draws the current clip: one-shot (pat, eat, evolve...) if running, else the given loop.
void drawPetSprite(const Pet &p, const char *loopName, int x0, int y0, int s) {
  uint32_t now = millis();
  if (onceClip) {
    int idx = (now - onceStart) * onceClip->fps / 1000;
    if (idx < onceClip->frame_count) { drawClipFrame(onceClip, idx, p, x0, y0, s); return; }
    onceClip = nullptr;
  }
  const nl_clip_t *c = pickClip(loopName, p);
  if (!c) return;
  if (loopKey != c->name) { loopKey = c->name; loopStart = now; }
  int idx = ((now - loopStart) * c->fps / 1000) % c->frame_count;
  drawClipFrame(c, idx, p, x0, y0, s);
}
const char *stateClip(const String &ds) {
  if (ds == "sad") return "sad";
  if (ds == "hungry") return "hungry";
  if (ds == "sleepy") return "sleep";
  if (ds == "starving") return "starving";
  if (ds == "dormant") return "dormant";
  return "idle";
}
const char *emotionClip(const String &e) {
  if (e == "excited") return "celebrate";
  if (e == "sleepy") return "sleep";
  if (e == "sad") return "sad";
  if (e == "hungry") return "hungry";
  if (e == "curious") return "think";
  if (e == "silly") return "dizzy";
  return "idle";
}

// hearts after a pat
struct Heart { int16_t x; uint32_t t0; };
Heart hearts[6];
void spawnHearts() {
  for (int i = 0; i < 6; i++) hearts[i] = {(int16_t)(60 + esp_random() % 120), millis() + i * 120};
}
void drawHearts(Adafruit_GFX &g) {
  static const char *H[4] = {".x.x.", "xxxxx", ".xxx.", "..x.."};
  uint32_t now = millis();
  for (auto &h : hearts) {
    if (!h.t0 || now < h.t0) continue;
    uint32_t a = now - h.t0;
    if (a > 1200) { h.t0 = 0; continue; }
    int y = 170 - a / 8;
    for (int r = 0; r < 4; r++)
      for (int c = 0; c < 5; c++)
        if (H[r][c] == 'x') g.fillRect(h.x + c * 3, y + r * 3, 3, 3, C_RED);
  }
}

