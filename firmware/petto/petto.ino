    drawEgg(g, 80, 50, 5, 0);
    textCenter(g, "waking up...", 170, 1, C_INK);
    if (note.length()) textCenter(g, note, 186, 1, C_RED);
    hintBar(g, "Petto " FW_VERSION);
  } else if (mode == M_MENU) {
    textCenter(g, "Menu", 12, 2, C_INK);
    for (int i = 0; i < MENU_N; i++) {
      int y = 44 + i * 34;
      if (i == menuSel) g.fillRoundRect(20, y - 6, 200, 26, 6, C_SPOT);
      textCenter(g, MENU[i], y, 2, i == menuSel ? C_WHITE : C_INK);
