const char *SPROUT[9] = {"..LL..LL..", "...LLLL...", "....oo....", "..oooooo..", ".oggggggo.",
                         ".ogeggego.", ".ocggggco.", ".oggggggo.", "..oooooo.."};
void drawSprout(Adafruit_GFX &g, int x, int y, int s) {
  for (int r = 0; r < 9; r++)
    for (int c = 0; SPROUT[r][c]; c++) {
      uint16_t col;
      switch (SPROUT[r][c]) {
        case 'L': col = C_LEAF; break;
        case 'o': case 'e': col = C_INK; break;
        case 'g': col = C_BODY; break;
        case 'c': col = C_CHEEK; break;
        default: continue;
      }
      g.fillRect(x + c * s, y + r * s, s, s, col);
    }
}
void drawEgg(Adafruit_GFX &g, int x, int y, int s, float lean) {
  const int W = 16, H = 20;
  auto inside = [&](int i, int j) -> bool {
    if (i < 0 || j < 0 || i >= W || j >= H) return false;
    float v = (j + 0.5f) / H * 2.f - 1.f;
    float halfw = 0.5f * sqrtf(fmaxf(0, 1 - v * v)) * (1.0f + 0.18f * v) * 1.02f;
    float u = (i + 0.5f) / W - 0.5f - lean * (1 - v) * 0.05f;
    return fabsf(u) < halfw;
  };
  const uint8_t spots[][2] = {{5, 6}, {10, 9}, {6, 13}, {11, 15}, {8, 4}};
  for (int j = 0; j < H; j++)
    for (int i = 0; i < W; i++) {
      if (!inside(i, j)) continue;
      bool edge = !inside(i - 1, j) || !inside(i + 1, j) || !inside(i, j - 1) || !inside(i, j + 1);
      uint16_t col = edge ? C_INK : C_EGG;
      if (!edge && i >= 3 && i <= 5 && j >= 3 && j <= 6 && (i + j) % 2 == 0) col = C_EGG_HI;
      for (auto &sp : spots) if (!edge && sp[0] == i && sp[1] == j) col = C_SPOT;
      g.fillRect(x + i * s, y + j * s, s, s, col);
    }
}
void drawTitle(Adafruit_GFX &g, int x, int y, int size) {
  g.setTextSize(size); g.setTextColor(C_INK); g.setCursor(x, y); g.print("Petto");
