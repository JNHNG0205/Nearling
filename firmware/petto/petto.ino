void renderFrame() {
  if (!cv) return;
  Adafruit_GFX &g = *cv;
  // snapshot shared state
  Phase ph; String note, qurl, pstat, pname, reply, emo, feed, web, ref, inbox; int64_t pexp; Pet p; TalkSt ts; bool canned;
  {
    Lock l;
    ph = phase; note = netNote; qurl = qrUrl; pstat = pairStatus; pname = pairName; pexp = pairExpiresMs; p = pet;
    ts = talkSt; reply = replyText; emo = replyEmotion; canned = replyCanned; feed = feedUrl; web = cfgWeb; ref = petRef;
  }
  uint32_t now = millis();
  g.fillScreen(C_BG);

  if (ph == PH_BOOT || ph == PH_NOWIFI || ph == PH_HELLO || ph == PH_LOST) {
    drawSprout(g, 30, 36 + (int)(sinf(now / 300.0f) * 2), 3);
    drawSprout(g, 128, 40 + (int)(sinf(now / 300.0f + 2) * 2), 3);
    drawTitle(g, 31, 60, 6);
    drawEgg(g, 96, 112, 3, sinf(now / 600.0f));
    String line = ph == PH_LOST ? "Unpair this device on the web" : ph == PH_HELLO ? "talking to the brain..." : "connecting Wi-Fi...";
    textCenter(g, line, 188, 1, C_INK);
    if (note.length()) textCenter(g, note, 202, 1, C_RED);
    hintBar(g, "Petto " FW_VERSION);
  } else if (ph == PH_PAIRING) {
    if (pstat == "awaiting_confirm" && !pairDeclined) {
      drawEgg(g, 80, 30, 5, sinf(now / 200.0f) * 1.5f);
      textCenter(g, "Pair " + pname + "?", 150, 2, C_INK);
      textCenter(g, "Press B to hatch", 180, 1, C_INK);
      hintBar(g, "B yes      A no");
    } else {
      drawQR(g, qurl, 120, 100, 184);
      String sub = pstat == "claimed" ? "almost there..." : "Scan to hatch";
      int64_t left = pexp && epochMs() ? (pexp - epochMs()) / 1000 : -1;
      if (left >= 0) sub += "  " + String((int)(left / 60)) + ":" + (left % 60 < 10 ? "0" : "") + String((int)(left % 60));
      textCenter(g, sub, 200, 1, C_INK);
      if (note.length()) textCenter(g, note, 212, 1, C_RED);
      hintBar(g, pairDeclined ? "declined: scan again on the web" : "scan with your phone");
