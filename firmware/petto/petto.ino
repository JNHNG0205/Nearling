    g.setTextSize(1); g.setTextColor(C_INK);
    int y = 44;
    auto row = [&](const String &k, const String &v) { g.setCursor(12, y); g.print(k); g.setCursor(70, y); g.print(v.substring(0, 27)); y += 14; };
    row("id", hwId);
    row("wifi", WiFi.isConnected() ? WiFi.SSID() + " " + String(WiFi.RSSI()) + "dBm" : String("offline"));
    row("ip", WiFi.localIP().toString());
    String br; { Lock l; br = cfgBrain; }
    row("brain", br.length() > 8 ? br.substring(8) : br);
    row("pet", ref);
    row("fw", FW_VERSION);
    row("mic", micOK ? "ok" : "ERR");
    row("speaker", spkOK ? "ok" : "ERR");
    row("motion", mpuOK ? "ok" : "ERR");
    row("psram", String(ESP.getPsramSize() / 1024) + " KB");
    hintBar(g, "A back");
  } else {
    // ---- pet screen ----
    bool talking = recording || ts == TK_SENDING || ts == TK_SPEAKING || ts == TK_SHOW || now < bubbleUntil;
    // header: name + fuel
    g.setTextSize(2); g.setTextColor(C_INK); g.setCursor(10, 8); g.print(p.name.substring(0, 10));
    int fw = 70, fx = 160, fill = min(p.fuel, 20) * (fw - 2) / 20;
    g.drawRect(fx, 10, fw, 10, C_INK);
    g.fillRect(fx + 1, 11, fill, 8, p.fuel == 0 ? C_RED : p.fuelLow ? C_LEAF : C_SPOT);
    g.setTextSize(1); g.setCursor(fx, 24); g.print(String(p.fuel) + " fuel");
    if (p.demo) { g.setCursor(10, 26); g.setTextColor(C_SPOT); g.print("demo speed"); }

    const char *loopName = stateClip(p.dstate);
    if (now < sleepUntil) loopName = "sleep";
    if (now < emotionUntil) loopName = emotionClip(emotionNow);
    if (recording) loopName = "listen";
    else if (ts == TK_SENDING) loopName = "think";
    else if (ts == TK_SPEAKING) loopName = "talk";

    if (!talking) {
      drawPetSprite(p, loopName, 40, 40, 5);   // 160 px
      drawHearts(g);
      if (p.fuel == 0) textCenter(g, "out of fuel: feed me!", 210, 1, C_RED);
      else if (p.fuelLow) textCenter(g, "fuel is low", 210, 1, C_INK);
      hintBar(g, "B menu   hold B talk   C pat");
    } else {
      drawPetSprite(p, loopName, 72, 32, 3);   // 96 px, bubble below
      if (recording) {
        g.fillRoundRect(50, 140, 140, 24, 12, C_RED);
        textCenter(g, "listening...", 148, 1, C_WHITE);
        g.drawRect(40, 176, 160, 10, C_INK);
        g.fillRect(41, 177, micLevel * 158 / 100, 8, C_SPOT);
        float secs = (now - recStart) / 1000.0f;
        textCenter(g, String(secs, 1) + " / " + String(REC_MAX_SECONDS) + " s", 194, 1, C_INK);
        hintBar(g, "release B to send");
      } else if (ts == TK_SENDING) {
        g.fillRoundRect(6, 134, 228, 50, 8, C_WHITE);
        g.drawRoundRect(6, 134, 228, 50, 8, C_INK);
        String dots = "thinking";
        for (int i = 0; i < (int)(now / 400) % 4; i++) dots += ".";
        textCenter(g, dots, 154, 2, C_INK);
        hintBar(g, "private AI on NEAR, 1 fuel");
      } else {
        drawBubble(g, 134);
        hintBar(g, feed.length() || (canned && p.fuel == 0) ? "A close    C feed me" : "A close");
      }
    }
  }
  tft.drawRGBBitmap(0, 0, cv->getBuffer(), TFT_W, TFT_H);
}

// =====================================================================
// UI logic
// =====================================================================
void stopRecording(bool send) {
  recording = false;
  uint32_t ms = recLen * 1000 / MIC_SAMPLE_HZ;
  if (!send || ms < REC_MIN_MS) { Serial.println("[MIC] too short, ignored"); return; }
  Serial.printf("[MIC] recorded %.1f s\n", ms / 1000.0f);
  Lock l;
  talkReady = true; talkSt = TK_SENDING;
}

void uiPet(const Pet &p, TalkSt ts) {
  uint32_t now = millis();
  bool busy = recording || ts == TK_SENDING || ts == TK_SPEAKING;
  // B: short = menu, hold = talk
  if (bB.holdStart && !busy && ts != TK_SHOW && now >= bubbleUntil) {
    recLen = 0; recording = true; recStart = now;
    Serial.println("[MIC] listening");
  }
  if (recording && recLen >= REC_MAX_SAMPLES) { bB.consumed = true; stopRecording(true); }
  if (bB.released && recording) stopRecording(true);
  if (bB.shortPress && !busy && ts != TK_SHOW && now >= bubbleUntil) { mode = M_MENU; menuSel = 0; return; }

  if (ts == TK_SHOW || now < bubbleUntil) {
    if (bA.shortPress) { Lock l; if (talkSt == TK_SHOW) talkSt = TK_IDLE; bubbleUntil = 0; }
    String feed; bool canned;
    { Lock l; feed = feedUrl; canned = replyCanned; }
    if (bC.shortPress && (feed.length() || (canned && p.fuel == 0))) { Lock l; if (talkSt == TK_SHOW) talkSt = TK_IDLE; bubbleUntil = 0; mode = M_FEEDQR; }
    return;
  }
  if (busy) return;
  // C: pat
  if (bC.shortPress) {
    playOnce("pat", p); spawnHearts(); enqueueCare("pat"); playTone(1200, 60);
  }
  // motion care
  if (mpuOK) {
    if (shake > SHAKE_THRESHOLD && now - lastShake > 4000) {
      lastShake = now; playOnce("dizzy", p); enqueueCare("shake");
    }
    int sgn = axF > 0.12f ? 1 : axF < -0.12f ? -1 : 0;
    if (sgn && sgn != rockSign) {
      if (rockSign) { memmove(rockTimes, rockTimes + 1, sizeof(uint32_t) * 3); rockTimes[3] = now; }
      rockSign = sgn;
    }
    if (shake < 1.0f && rockTimes[1] && now - rockTimes[1] < 3000 && now - lastRock > 6000) {
      lastRock = now; memset(rockTimes, 0, sizeof(rockTimes));
      playOnce("rock", p); enqueueCare("rock");
    }
  }
}

void uiLoop() {
  Phase ph; Pet p; TalkSt ts; String reply, emo, inbox; bool inNew, evolved;
  {
    Lock l;
    ph = phase; p = pet; ts = talkSt; reply = replyText; emo = replyEmotion;
    inNew = inboxNew; inbox = inboxText; inboxNew = false;
    evolved = evolvedNow; evolvedNow = false;
  }
  uint32_t now = millis();
  // transitions coming from the net task
  if (ts != lastTalkSt) {
    if (ts == TK_SHOW && lastTalkSt != TK_SHOW) {
      showBubble(reply, 8000 + reply.length() * 60);
      emotionNow = emo; emotionUntil = bubbleUntil;
    }
    if (ts == TK_SPEAKING) showBubble(reply, 600000);
    if (ts == TK_IDLE) bubbleUntil = 0;
    lastTalkSt = ts;
  }
  if (ts == TK_SHOW && now > bubbleUntil) { Lock l; if (talkSt == TK_SHOW) talkSt = TK_IDLE; }
  if (inNew && ph == PH_PET && ts == TK_IDLE) { chime(); showBubble(inbox, 9000); Serial.println("[INBOX] new message shown"); }
  if (p.valid) {
    if (havePetBefore && p.hatched && !lastHatched) { Pet e = p; e.hatched = false; playOnce("egg_hatch", e); chime(); }
    lastHatched = p.hatched; havePetBefore = true;
    if (evolved) { playOnce("evolve", p); chime(); }
  }

  if (ph == PH_PAIRING) {
    if (bB.shortPress && !pairDeclined) {
      Lock l;
      if (pairStatus == "awaiting_confirm") { wantConfirm = true; }
    }
    if (bA.shortPress) pairDeclined = true;
    if (bB.shortPress && pairDeclined) pairDeclined = false;
    return;
  }
  pairDeclined = false;
  if (ph != PH_PET || !p.valid) { mode = M_PET; return; }

  switch (mode) {
    case M_PET: uiPet(p, ts); break;
    case M_MENU:
      if (bA.shortPress) menuSel = (menuSel + MENU_N - 1) % MENU_N;
      if (bC.shortPress) menuSel = (menuSel + 1) % MENU_N;
      if (bB.shortPress) {
        switch (menuSel) {
          case 0: mode = M_STATS; break;
          case 1: enqueueCare("sleep"); sleepUntil = now + 20000; mode = M_PET; break;
          case 2: { Lock l; feedUrl = ""; } mode = M_FEEDQR; break;
          case 3: mode = M_DEVICE; break;
          default: mode = M_PET;
        }
      }
      break;
    default:
      if (bA.shortPress || bB.shortPress) mode = M_PET;
  }
}

// =====================================================================
// serial commands (line based)
// =====================================================================
void help() {
  Serial.println(F("\n--- Petto commands ---"));
  Serial.println(F(" w ssid,pass   set Wi-Fi          u <url>   set brain URL"));
  Serial.println(F(" i             info               f         forget pairing (new pairing on next hello)"));
  Serial.println(F(" v 0.4         volume 0..0.6      s         sensor log on/off"));
  Serial.println(F(" b             beep               n         scan Wi-Fi networks"));
  Serial.println(F(" h             this help\n"));
}
void info() {
  Lock l;
  Serial.printf("fw %s  hw_id %s  wifi '%s' %s  IP %s\n", FW_VERSION, hwId.c_str(), cfgSsid.c_str(),
                WiFi.isConnected() ? "up" : "down", WiFi.localIP().toString().c_str());
  Serial.printf("brain %s  web %s  pet %s  token %s\n", cfgBrain.c_str(), cfgWeb.c_str(), petRef.c_str(), devToken.length() ? "stored" : "none");
  Serial.printf("mic %d spk %d mpu %d  PSRAM %u KB  heap %u KB  phase %d\n", micOK, spkOK, mpuOK,
                ESP.getPsramSize() / 1024, ESP.getFreeHeap() / 1024, phase);
}
void serialPoll() {
  static String line;
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\r') continue;
    if (c != '\n') { if (line.length() < 200) line += c; continue; }
    String cmd = line; line = ""; cmd.trim();
    if (!cmd.length()) continue;
    char k = cmd[0];
    String arg = cmd.length() > 2 ? cmd.substring(2) : "";
    arg.trim();
    if (k == 'h') help();
    else if (k == 'i') info();
    else if (k == 'b') playTone(880, 200);
    else if (k == 'n') { Lock l; wantScan = true; }
    else if (k == 's') logSensors = !logSensors;
    else if (k == 'v') { volume = constrain(arg.toFloat(), 0.0f, AMP_VOLUME_MAX); Serial.printf("volume %.2f\n", volume); }
    else if (k == 'w') {
      int comma = arg.indexOf(',');
      String ss = comma < 0 ? arg : arg.substring(0, comma), pw = comma < 0 ? "" : arg.substring(comma + 1);
      { Lock l; cfgSsid = ss; cfgPass = pw; prefs.putString("ssid", ss); prefs.putString("pass", pw); wantReconnect = true; }
      Serial.printf("Wi-Fi set to '%s' (password %u characters), reconnecting\n", ss.c_str(), (unsigned)pw.length());
    } else if (k == 'u') {
      while (arg.endsWith("/")) arg.remove(arg.length() - 1);
      { Lock l; cfgBrain = arg; prefs.putString("brain", arg); wantHello = true; }
      Serial.printf("brain URL set to %s\n", arg.c_str());
    } else if (k == 'f') {
      { Lock l; devToken = ""; petRef = ""; pet.valid = false; prefs.remove("token"); prefs.remove("pet_ref"); wantHello = true; }
      Serial.println("pairing forgotten");
    } else Serial.println("unknown command, h for help");
  }
}

// =====================================================================
void setup() {
  Serial.begin(115200);
  delay(800);
  Serial.printf("\n\n=== Petto %s ===\n", FW_VERSION);
  Serial.printf("[CHIP] %s, PSRAM %u KB\n", ESP.getChipModel(), ESP.getPsramSize() / 1024);
  if (!ESP.getPsramSize()) Serial.println(F("[WARN] PSRAM 0 KB -> Tools > PSRAM > OPI PSRAM"));
  mtx = xSemaphoreCreateMutex();
  spkMtx = xSemaphoreCreateMutex();

  pinMode(PIN_BTN_A, INPUT_PULLUP); pinMode(PIN_BTN_B, INPUT_PULLUP); pinMode(PIN_BTN_C, INPUT_PULLUP);

  // screen
  pinMode(PIN_TFT_BLK, OUTPUT); digitalWrite(PIN_TFT_BLK, HIGH);
  SPI.begin(PIN_TFT_SCLK, -1, PIN_TFT_MOSI, -1);
  tft.init(TFT_W, TFT_H, TFT_SPI_MODE);
  tft.setSPISpeed(40000000);
  tft.setRotation(TFT_ROTATION);
  C_BG = tft.color565(246, 250, 243); C_INK = tft.color565(26, 52, 36); C_EGG = tft.color565(196, 240, 204);
  C_EGG_HI = tft.color565(232, 252, 236); C_SPOT = tft.color565(88, 196, 120); C_LEAF = tft.color565(120, 214, 96);
  C_BODY = tft.color565(98, 204, 120); C_CHEEK = tft.color565(150, 230, 168); C_RED = tft.color565(220, 70, 60);
  C_GREY = tft.color565(205, 214, 205); C_WHITE = 0xFFFF; C_BLACK = 0x0000;
  tft.fillScreen(C_BG);
  cv = new GFXcanvas16(TFT_W, TFT_H);
  if (!cv->getBuffer()) { delete cv; cv = nullptr; Serial.println(F("[TFT] no frame buffer: enable OPI PSRAM")); }

  // NVS
  prefs.begin("nearling", false);
  cfgSsid = prefs.getString("ssid", WIFI_SSID);
  cfgPass = prefs.getString("pass", WIFI_PASS);
  cfgBrain = prefs.getString("brain", BRAIN_URL);
  cfgWeb = WEB_URL;
  devSecret = prefs.getString("secret", "");
  if (devSecret.length() < 16) { devSecret = randomChars(32); prefs.putString("secret", devSecret); }   // once per device, never regenerated
  devToken = prefs.getString("token", "");
  petRef = prefs.getString("pet_ref", "");
  careCounter = prefs.getUInt("care_n", 0);
  inboxAfter = prefs.getLong64("inbox_after", 0);
  char id[13];
  snprintf(id, sizeof(id), "%012llx", (unsigned long long)ESP.getEfuseMac());
  hwId = id;

  // motion
  Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL, 400000);
  // costume data must come from the same sprite export as nearling_sprites.h
  costumesOk = NL_COSTUME_CLIPS == NL_CLIP_COUNT;
  for (int i = 0; costumesOk && i < NL_CLIP_COUNT; i++) costumesOk = NL_COSTUME_CLIP_FRAMES[i] == NL_CLIPS[i].frame_count;
  Serial.println(costumesOk ? "[ART] costumes ok" : "[ART] costume table out of date: re-run firmware/tools/export-costumes.ts");

  mpuOK = mpuInit();
  Serial.println(mpuOK ? "[MPU] ok" : "[MPU] NOT FOUND (SDA 1, SCL 2)");

  // audio: two separate I2S peripherals
  mic.setPins(PIN_MIC_SCK, PIN_MIC_WS, -1, PIN_MIC_SD);
  micOK = mic.begin(I2S_MODE_STD, MIC_SAMPLE_HZ, I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_MONO, I2S_STD_SLOT_LEFT);
  spk.setPins(PIN_AMP_BCLK, PIN_AMP_LRC, PIN_AMP_DIN);
  spkOK = spk.begin(I2S_MODE_STD, MIC_SAMPLE_HZ, I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_MONO);
  recBuf = (int16_t *)ps_malloc(REC_MAX_SAMPLES * 2);
  talkBuf = (uint8_t *)ps_malloc(REC_MAX_SAMPLES * 2 + 1024);
  if (!recBuf || !talkBuf) { micOK = false; Serial.println(F("[MIC] no PSRAM buffer, talk disabled")); }
  Serial.printf("[MIC] %s  [SPK] %s\n", micOK ? "ok" : "FAILED", spkOK ? "ok" : "FAILED");

  xTaskCreatePinnedToCore(micTask, "mic", 4096, nullptr, 3, nullptr, 1);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.onEvent([](arduino_event_id_t e, arduino_event_info_t info) {   // say why a join failed
    if (e != ARDUINO_EVENT_WIFI_STA_DISCONNECTED) return;
    uint8_t r = info.wifi_sta_disconnected.reason;
    const char *hint = (r == 15 || r == 202 || r == 204 || r == 2) ? "  -> wrong password, or set hotspot security to WPA2"
                     : (r == 201) ? "  -> network not found: 2.4 GHz band? exact name?" : "";
    Serial.printf("[WIFI] join failed: reason %u %s%s\n", r, WiFi.disconnectReasonName((wifi_err_reason_t)r), hint);
  });
  xTaskCreatePinnedToCore(netTask, "net", 20480, nullptr, 1, nullptr, 0);

  playTone(660, 120); playTone(990, 160);
  help();
  info();
}

void loop() {
  serialPoll();
  mpuRead();
  bA.update(); bB.update(); bC.update();
  uiLoop();
  static uint32_t lastDraw = 0, lastLog = 0;
  if (millis() - lastDraw >= 40) { lastDraw = millis(); renderFrame(); }
  if (logSensors && millis() - lastLog > 300) {
    lastLog = millis();
    Serial.printf("BTN A%d B%d C%d | acc %+5.2f %+5.2f %+5.2f | shake %4.1f | mic %3d%%\n", bA.down, bB.down, bC.down,
                  ax, ay, az, shake, micLevel);
  }
  delay(2);
}
