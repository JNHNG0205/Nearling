struct Btn {
  uint8_t pin;
  bool raw = false, down = false, held = false, consumed = false;
  uint32_t changedAt = 0, downAt = 0;
  bool pressed = false, released = false, holdStart = false, shortPress = false;
  void update() {
    pressed = released = holdStart = shortPress = false;
    bool r = !digitalRead(pin);
    uint32_t now = millis();
    if (r != raw) { raw = r; changedAt = now; }
    if (now - changedAt >= BTN_DEBOUNCE_MS && raw != down) {
      down = raw;
      if (down) { pressed = true; downAt = now; held = false; consumed = false; }
      else { released = true; if (!held && !consumed) shortPress = true; }
    }
    if (down && !held && now - downAt >= BTN_HOLD_MS) { held = true; holdStart = true; }
  }
};
Btn bA{PIN_BTN_A}, bB{PIN_BTN_B}, bC{PIN_BTN_C};

