// =====================================================================
// small helpers
// =====================================================================
String randomChars(int n) {
  static const char *A = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  String s;
  for (int i = 0; i < n; i++) s += A[esp_random() % 62];
  return s;
}
int64_t epochMs() {
  time_t t = time(nullptr);
  if (t < 1700000000) return 0;   // SNTP not synced yet
  struct timeval tv;
  gettimeofday(&tv, nullptr);
  return (int64_t)tv.tv_sec * 1000 + tv.tv_usec / 1000;
}
String urlEncodeRef(const String &r) {   // contract:token -> contract%3Atoken
  String o = r;
  o.replace(":", "%3A");
  return o;
}
// The built-in GFX font is ASCII only: map common Unicode punctuation, drop the rest.
String asciiize(const String &in) {
  String o;
  for (size_t i = 0; i < in.length();) {
    uint8_t c = in[i];
    if (c < 0x80) { o += (char)c; i++; continue; }
    int len = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : 2;
    if (len == 3 && i + 2 < in.length() && (uint8_t)in[i] == 0xE2 && (uint8_t)in[i + 1] == 0x80) {
      uint8_t d = in[i + 2];
      if (d == 0x98 || d == 0x99) o += '\'';
      else if (d == 0x9C || d == 0x9D) o += '"';
      else if (d == 0x93 || d == 0x94) o += '-';
      else if (d == 0xA6) o += "...";
    }
    i += len;
  }
  return o;
}
std::vector<String> wrapText(const String &t, int cols) {
  std::vector<String> lines;
  String line, word;
  auto flushWord = [&]() {
    while ((int)word.length() > cols) {   // very long word: hard split
      if (line.length()) { lines.push_back(line); line = ""; }
      lines.push_back(word.substring(0, cols));
      word = word.substring(cols);
    }
    if (!word.length()) return;
    if (line.length() + 1 + word.length() > (size_t)cols && line.length()) { lines.push_back(line); line = ""; }
    line += (line.length() ? " " : "") + word;
    word = "";
  };
  for (size_t i = 0; i < t.length(); i++) {
    char c = t[i];
    if (c == ' ' || c == '\n') { flushWord(); if (c == '\n' && line.length()) { lines.push_back(line); line = ""; } }
    else word += c;
  }
  flushWord();
  if (line.length()) lines.push_back(line);
  return lines;
}
void saveStr(const char *k, const String &v) { Lock l; prefs.putString(k, v); }

// =====================================================================
// audio
// =====================================================================
void micTask(void *) {
  static int32_t raw[256];
  float dc = 0;
  for (;;) {
    if (!micOK) { vTaskDelay(100); continue; }
    size_t n = mic.readBytes((char *)raw, sizeof(raw)) / 4;
    int32_t peak = 0;
    for (size_t i = 0; i < n; i++) {
      float s = (float)(raw[i] >> 14);
      dc = dc * 0.995f + s * 0.005f;
      int32_t v = constrain((int32_t)(s - dc), -32768, 32767);
      if (abs(v) > peak) peak = abs(v);
      size_t at = recLen;
      if (recording && at < REC_MAX_SAMPLES) { recBuf[at] = (int16_t)v; recLen = at + 1; }
    }
    int lvl = map(constrain(peak, 0, 12000), 0, 12000, 0, 100);
    micLevel = max(lvl, micLevel - 3);
  }
}
void playTone(int freq, int ms) {
  if (!spkOK) return;
  if (xSemaphoreTake(spkMtx, 0) != pdTRUE) return;   // voice is playing: skip the beep
  static int16_t buf[256];
  const int N = MIC_SAMPLE_HZ * ms / 1000;
  const float vol = 32767 * volume, step = 2 * PI * freq / MIC_SAMPLE_HZ;
  float ph = 0;
  for (int done = 0; done < N;) {
    int n = min(N - done, 256);
    for (int i = 0; i < n; i++) {
      int k = done + i;
      float env = min(1.0f, min(k / 200.0f, (N - k) / 200.0f));
      buf[i] = (int16_t)(sinf(ph) * vol * env);
      ph += step;
    }
    spk.write((uint8_t *)buf, n * 2);
    done += n;
  }
  xSemaphoreGive(spkMtx);
}
void chime() { playTone(880, 70); playTone(1320, 110); }

// =====================================================================
// MPU6050 (raw registers)
// =====================================================================
bool mpuWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(mpuAddr); Wire.write(reg); Wire.write(val);
  return Wire.endTransmission() == 0;
}
bool mpuInit() {
  for (uint8_t a : {0x68, 0x69}) {
    mpuAddr = a;
    Wire.beginTransmission(a); Wire.write(0x75);
    if (Wire.endTransmission(false) != 0) continue;
    if (Wire.requestFrom((int)a, 1) != 1) continue;
    Wire.read();   // WHO_AM_I: clones report 0x68/0x70/0x72/0x98, accept any
    mpuWrite(0x6B, 0x00); mpuWrite(0x1C, 0x00); mpuWrite(0x1B, 0x00);
    return true;
  }
  return false;
}
void mpuRead() {
  if (!mpuOK) return;
  Wire.beginTransmission(mpuAddr); Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return;
  if (Wire.requestFrom((int)mpuAddr, 14) != 14) return;
  int16_t v[7];
  for (int i = 0; i < 7; i++) v[i] = (Wire.read() << 8) | Wire.read();
  ax = v[0] / 16384.0f; ay = v[1] / 16384.0f; az = v[2] / 16384.0f;
  axF = axF * 0.85f + ax * 0.15f;
  float mag = sqrtf(ax * ax + ay * ay + az * az);
  shake = shake * 0.85f + fabsf(mag - 1.0f) * 0.15f * 10.0f;
}

// =====================================================================
// care queue (UI pushes, net task flushes)
// =====================================================================
void enqueueCare(const char *kind) {
  uint32_t n;
  {
    Lock l;
    if (careQ.size() >= 64) careQ.erase(careQ.begin());
    n = ++careCounter;
    CareEv e{n, {0}, millis()};
    strncpy(e.kind, kind, sizeof(e.kind) - 1);
    careQ.push_back(e);
    prefs.putUInt("care_n", careCounter);
  }
  Serial.printf("[CARE] queued %s #%u\n", kind, (unsigned)n);
}

// =====================================================================
// networking (net task only)
// =====================================================================
WiFiClientSecure tlsClient;
WiFiClient plainClient;
String nBrain, nToken, nRef;   // net-task copies of the config

bool beginReq(HTTPClient &h, const String &path) {
  String url = nBrain + path;
  if (url.startsWith("https://")) {
    tlsClient.setInsecure();   // TODO: use the CA bundle (setCACertBundle) after the demo
    return h.begin(tlsClient, url);
  }
  return h.begin(plainClient, url);
}
void addAuth(HTTPClient &h, Auth a) {
  if (a == AUTH_SECRET) { h.addHeader("X-Device-Id", hwId); h.addHeader("X-Device-Secret", devSecret); }
  else if (a == AUTH_TOKEN && nToken.length()) h.addHeader("Authorization", "Device " + nToken);
}
Resp request(const char *method, const String &path, const String &body, Auth a, uint32_t timeoutMs = 10000) {
  Resp r{-1, ""};
  HTTPClient h;
  if (!nBrain.length() || !beginReq(h, path)) return r;
  h.setConnectTimeout(8000);
  h.setTimeout(timeoutMs);
  addAuth(h, a);
  uint32_t t0 = millis();
  if (!strcmp(method, "GET")) r.code = h.GET();
  else {
    h.addHeader("Content-Type", "application/json");
    r.code = h.sendRequest(method, (uint8_t *)body.c_str(), body.length());
  }
  if (r.code > 0) r.body = h.getString();
  int q = path.indexOf('?');
  Serial.printf("[NET] %s %s -> %d (%lu ms)\n", method, (q < 0 ? path : path.substring(0, q)).c_str(), r.code,
                (unsigned long)(millis() - t0));
  h.end();
  return r;
}
String errCode(const String &body) {
  JsonDocument d;
  if (deserializeJson(d, body)) return "";
  return d["error"]["code"] | "";
}
void setNote(const String &s) { Lock l; netNote = s; }
void setPhase(Phase p) { Lock l; phase = p; }
void forgetToken() {
  { Lock l; devToken = ""; petRef = ""; pet.valid = false; prefs.remove("token"); prefs.remove("pet_ref"); }
  nToken = ""; nRef = "";
}
// Any pet route answering 401 / 403 not_owner, or state saying unpaired: start over (protocol 3).
bool handleAuthLoss(const Resp &r) {
  if (r.code == 401 || (r.code == 403 && errCode(r.body) == "not_owner")) {
    Serial.println("[NET] device token no longer valid, pairing again");
    forgetToken();
    Lock l; wantHello = true;
    return true;
  }
  return false;
}

void doHello() {
  JsonDocument d;
  d["hw_id"] = hwId; d["device_secret"] = devSecret; d["fw_version"] = FW_VERSION;
  String b; serializeJson(d, b);
  Resp r = request("POST", "/devices/hello", b, AUTH_NONE);
  if (r.code != 200) { setNote(r.code < 0 ? "can't reach the brain" : "brain error " + String(r.code)); setPhase(PH_HELLO); return; }
  JsonDocument res;
  if (deserializeJson(res, r.body)) { setNote("bad hello reply"); return; }
  setNote("");
  if (res["bound"] | false) {
    String ref = res["pet_ref"] | "";
    if (nToken.length()) {
      { Lock l; petRef = ref; phase = PH_PET; wantStateNow = true; prefs.putString("pet_ref", ref); }
      nRef = ref;
    } else {
      setPhase(PH_LOST);   // bound, but the token was lost: the owner must unpair on the web
    }
  } else {
    forgetToken();
    String url = res["pairing"]["qr_url"] | "";
    int64_t exp = res["pairing"]["expires_at"] | (int64_t)0;
    int h = url.indexOf("/hatch");
    Lock l;
    qrUrl = url; pairExpiresMs = exp; pairStatus = "open"; pairName = "";
    if (h > 0) url = String(WEB_URL) + url.substring(h);   // keep "/hatch?t=<token>", use our domain
    cfgWeb = WEB_URL;
    phase = PH_PAIRING;
  }
}

void pollPairing() {
  Resp r = request("GET", "/devices/pairing", "", AUTH_SECRET);
  if (r.code == 404 || r.code == 410) { Lock l; wantHello = true; return; }
  if (r.code != 200) return;
  JsonDocument d;
  if (deserializeJson(d, r.body)) return;
  String st = d["status"] | "";
  String nm = d["pet_name"] | "";
  { Lock l; pairStatus = st; pairName = nm; }
  if (st == "expired" || st == "cancelled" || st == "confirmed") { Lock l; wantHello = true; }
}

void doConfirm() {
  Resp r = request("POST", "/devices/pairing/confirm", "", AUTH_SECRET);
  if (r.code != 200) { setNote("pairing failed (" + String(r.code) + ")"); Lock l; wantHello = true; return; }
  JsonDocument d;
  if (deserializeJson(d, r.body)) return;
  String tok = d["device_token"] | "", ref = d["pet_ref"] | "";
  {
    Lock l;
    devToken = tok; petRef = ref; phase = PH_PET; wantStateNow = true;
    prefs.putString("token", tok); prefs.putString("pet_ref", ref);
  }
  nToken = tok; nRef = ref;
  Serial.println("[PAIR] paired, token stored");
}

void pollState() {
  Resp r = request("GET", "/pets/" + urlEncodeRef(nRef) + "/state", "", AUTH_TOKEN);
  if (handleAuthLoss(r) || r.code != 200) return;
  JsonDocument d;
  if (deserializeJson(d, r.body)) { Serial.println("[NET] state: bad JSON"); return; }
  if (!(d["device"]["paired"] | true)) { forgetToken(); Lock l; wantHello = true; return; }
  Pet p;
  p.valid = true;
  p.name = asciiize(d["name"] | "Petto");
  p.stage = d["stage_index"] | 0;
  p.hatched = d["hatched"] | false;
  p.winged = String(d["form"] | "base") == "winged";
  JsonArray tr = d["traits"].as<JsonArray>();
  for (int i = 0; i < 5; i++) p.traits[i] = (uint8_t)constrain((int)(tr[i] | 50), 0, 100);
  p.dstate = d["display_state"] | "happy";
  p.shirt = d["equipped_shirt"].isNull() ? "" : String(d["equipped_shirt"].as<const char *>());
  const char *ck = d["equipped_costume"] | "";
  for (int i = 0; i < NL_COSTUME_COUNT; i++)
    if (!strcmp(ck, NL_COSTUME_KEYS[i])) { p.costume = i; break; }
  if (p.costume >= 0) p.shirt = "";   // the web draws a costume instead of the plain shirt
  p.fuel = d["fuel"]["left"] | 0;
  p.fuelLow = d["fuel"]["low"] | false;
  p.mood = d["care"]["mood"] | 0;
  p.xp = d["xp"] | 0;
  p.demo = d["demo_speed"] | false;
  Lock l; pet = p;
}

void pollInbox() {
  Resp r = request("GET", "/pets/" + urlEncodeRef(nRef) + "/inbox?after=" + String((long long)inboxAfter), "", AUTH_TOKEN);
  if (handleAuthLoss(r) || r.code != 200) return;
  JsonDocument d;
  if (deserializeJson(d, r.body)) return;
  JsonArray arr = d.as<JsonArray>();
  int64_t maxId = inboxAfter;
  String last;
  for (JsonObject it : arr) {
    int64_t id = it["id"] | (int64_t)0;
    if (id > maxId) maxId = id;
    String t = it["text"] | "";
    if (t.length()) last = t;
  }
  if (maxId <= inboxAfter) return;
  inboxAfter = maxId;
  { Lock l; prefs.putLong64("inbox_after", inboxAfter); if (last.length()) { inboxText = asciiize(last); inboxNew = true; } }
  request("POST", "/pets/" + urlEncodeRef(nRef) + "/inbox/ack", "{\"up_to\":" + String((long long)maxId) + "}", AUTH_TOKEN);
}

void flushCare() {
  int64_t nowMs = epochMs();
  if (!nowMs) return;   // need SNTP for "at"
  std::vector<CareEv> evs;
  { Lock l; evs = careQ; }
  if (evs.empty()) return;
  JsonDocument d;
  JsonArray arr = d["events"].to<JsonArray>();
  uint32_t nowM = millis();
  for (auto &e : evs) {
    JsonObject o = arr.add<JsonObject>();
    o["id"] = "c-" + hwId.substring(hwId.length() - 4) + "-" + String(e.n);
    o["kind"] = e.kind;
    o["at"] = nowMs - (int64_t)(nowM - e.atMillis);
  }
  String b; serializeJson(d, b);
  Resp r = request("POST", "/pets/" + urlEncodeRef(nRef) + "/care", b, AUTH_TOKEN);
  if (handleAuthLoss(r)) return;
  if (r.code == 200 || r.code == 400) {   // 400 = a bad batch; drop it rather than retry forever
    JsonDocument res;
    bool evolved = !deserializeJson(res, r.body) && (res["evolved_now"] | false);
    Lock l;
    size_t k = min(evs.size(), careQ.size());
    careQ.erase(careQ.begin(), careQ.begin() + k);
    if (evolved) evolvedNow = true;
    wantStateNow = true;
  }
}

void put16(uint8_t *p, uint16_t v) { p[0] = v; p[1] = v >> 8; }
void put32(uint8_t *p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }

// Streams a 16 kHz mono 16-bit WAV from the brain straight into the amp.
void playWav(const String &path) {
  if (!spkOK) return;
  HTTPClient h;
  if (!beginReq(h, path)) return;
  h.setTimeout(8000);
  const char *keys[] = {"Content-Type"};
  h.collectHeaders(keys, 1);
  int code = h.GET();
  Serial.printf("[NET] GET /audio -> %d\n", code);
  if (code != 200) { h.end(); return; }
  if (h.header("Content-Type").indexOf("wav") < 0) { Serial.println("[SPK] reply audio is not WAV, skipped"); h.end(); return; }
  WiFiClient *s = h.getStreamPtr();
  int remaining = h.getSize();
  uint8_t hdr[44];
  if (s->readBytes(hdr, 44) != 44) { h.end(); return; }
  if (remaining > 0) remaining -= 44;
  uint32_t rate = hdr[24] | (hdr[25] << 8) | (hdr[26] << 16) | ((uint32_t)hdr[27] << 24);
  if (rate != MIC_SAMPLE_HZ) Serial.printf("[SPK] WAV is %u Hz, expected 16000\n", (unsigned)rate);
  static int16_t buf[512];
  uint8_t *b8 = (uint8_t *)buf;
  size_t carry = 0;
  xSemaphoreTake(spkMtx, portMAX_DELAY);
  while (remaining != 0) {
    size_t want = sizeof(buf) - carry;
    if (remaining > 0 && want > (size_t)remaining) want = remaining;
    size_t n = s->readBytes(b8 + carry, want);
    if (!n) { if (!h.connected() && !s->available()) break; continue; }
    if (remaining > 0) remaining -= n;
    size_t tot = carry + n, samples = tot / 2;
    for (size_t i = 0; i < samples; i++) buf[i] = (int16_t)(buf[i] * volume);
    spk.write(b8, samples * 2);
    carry = tot & 1;
    if (carry) b8[0] = b8[samples * 2];
  }
  memset(buf, 0, sizeof(buf));
  spk.write(b8, sizeof(buf));   // trailing silence, no pop
  xSemaphoreGive(spkMtx);
  h.end();
}

void setReply(const String &text, const String &emo, bool canned, const String &feed, TalkSt st) {
  Lock l;
  replyText = asciiize(text); replyEmotion = emo; replyCanned = canned; feedUrl = feed; talkSt = st;
}

void doTalk() {
  size_t samples = recLen;
  uint32_t dataBytes = samples * 2;
  String reqId = "dev" + randomChars(20);
  const char *B = "pettoBoundary7d1b";
  String pre = String("--") + B + "\r\nContent-Disposition: form-data; name=\"request_id\"\r\n\r\n" + reqId +
               "\r\n--" + B + "\r\nContent-Disposition: form-data; name=\"voice\"\r\n\r\n1\r\n--" + B +
               "\r\nContent-Disposition: form-data; name=\"audio\"; filename=\"talk.wav\"\r\nContent-Type: audio/wav\r\n\r\n";
  String post = String("\r\n--") + B + "--\r\n";
  size_t len = 0;
  memcpy(talkBuf, pre.c_str(), pre.length()); len += pre.length();
  uint8_t *w = talkBuf + len;
  memcpy(w, "RIFF", 4); put32(w + 4, 36 + dataBytes); memcpy(w + 8, "WAVEfmt ", 8); put32(w + 16, 16);
  put16(w + 20, 1); put16(w + 22, 1); put32(w + 24, MIC_SAMPLE_HZ); put32(w + 28, MIC_SAMPLE_HZ * 2);
  put16(w + 32, 2); put16(w + 34, 16); memcpy(w + 36, "data", 4); put32(w + 40, dataBytes);
  len += 44;
  memcpy(talkBuf + len, recBuf, dataBytes); len += dataBytes;
  memcpy(talkBuf + len, post.c_str(), post.length()); len += post.length();

  int code = -1;
  String body;
  for (int attempt = 0; attempt < 2; attempt++) {   // retry once with the same request_id (never charged twice)
    HTTPClient h;
    if (!beginReq(h, "/pets/" + urlEncodeRef(nRef) + "/talk")) break;
    h.setConnectTimeout(8000);
    h.setTimeout(25000);
    addAuth(h, AUTH_TOKEN);
    h.addHeader("Content-Type", String("multipart/form-data; boundary=") + B);
    uint32_t t0 = millis();
    code = h.POST(talkBuf, len);
    if (code > 0) body = h.getString();
    Serial.printf("[NET] POST /talk (%.1f s audio) -> %d (%lu ms)\n", samples / (float)MIC_SAMPLE_HZ, code,
                  (unsigned long)(millis() - t0));
    h.end();
    if (code > 0) break;
  }
  Resp r{code, body};
  if (handleAuthLoss(r)) { setReply("", "happy", false, "", TK_IDLE); return; }
  if (code != 200) {
    String ec = errCode(body);
    if (code == 503 || ec == "brain_resting") setReply("zzz... my brain is resting. Try again soon.", "sleepy", true, "", TK_SHOW);
    else if (code == 429) setReply("Slow down, I'm still thinking!", "silly", true, "", TK_SHOW);
    else if (ec == "bad_audio") setReply("I couldn't hear that. Hold B and talk again?", "curious", true, "", TK_SHOW);
    else setReply(code < 0 ? "I can't reach my brain right now." : "Something went wrong (" + String(code) + ").", "sad", true, "", TK_SHOW);
    return;
  }
  JsonDocument d;
  if (deserializeJson(d, body)) { setReply("I got confused. Try again?", "sad", true, "", TK_SHOW); return; }
  String status = d["status"] | "done";
  String audio = d["audio_url"].isNull() ? "" : String(d["audio_url"].as<const char *>());
  String feed = d["feed_url"].isNull() ? "" : String(d["feed_url"].as<const char *>());
  int left = d["fuel"]["left"] | -1;
  bool canned = status != "done";
  setReply(d["reply"] | "", d["emotion"] | "happy", canned, feed, audio.length() ? TK_SPEAKING : TK_SHOW);
  Serial.printf("[TALK] status %s, fuel left %d, voice %s\n", status.c_str(), left, audio.length() ? "yes" : "no");
  if (audio.length()) playWav(audio);
  Lock l;
  if (talkSt == TK_SPEAKING) talkSt = TK_SHOW;
  wantStateNow = true;
}

// Lists the networks the board can see, so a wrong band (5 GHz) or name is obvious.
void scanWifi(const String &want) {
  Serial.println("[WIFI] scanning...");
  int n = WiFi.scanNetworks();
  bool found = false;
  for (int i = 0; i < n; i++) {
    static const char *ENC[] = {"open", "WEP", "WPA", "WPA2", "WPA/WPA2", "WPA2-Enterprise", "WPA3", "WPA2/WPA3", "WAPI", "OWE", "WPA3-Ent"};
    int e = WiFi.encryptionType(i);
    String ss = WiFi.SSID(i);
    if (ss == want) found = true;
    Serial.printf("  %-32s %4d dBm  ch %2d  %s%s\n", ss.c_str(), WiFi.RSSI(i), WiFi.channel(i),
                  e >= 0 && e < 11 ? ENC[e] : "?", ss == want ? "   <- yours" : "");
  }
  if (n <= 0) Serial.println("  no networks found (antenna / power?)");
  else if (!found) Serial.printf("[WIFI] '%s' is NOT visible: hotspot off, 5 GHz only, or name typed differently\n", want.c_str());
  WiFi.scanDelete();
}

void netTask(void *) {
  uint32_t lastPair = 0, lastState = 0, lastInbox = 0, lastCare = 0, lastHello = 0, wifiStart = 0;
  bool wasUp = false, timeSet = false;
  for (;;) {
    {
      Lock l;
      nBrain = cfgBrain; nToken = devToken; nRef = petRef;
    }
    bool reconnect;
    { Lock l; reconnect = wantReconnect; wantReconnect = false; }
    if (reconnect) { WiFi.disconnect(); wasUp = false; wifiStart = 0; }
    bool scan;
    { Lock l; scan = wantScan; wantScan = false; }
    if (scan) { String ss; { Lock l; ss = cfgSsid; } if (!wasUp) WiFi.disconnect(); scanWifi(ss); wifiStart = 0; }

    if (WiFi.status() != WL_CONNECTED) {
      if (wasUp) Serial.println("[WIFI] lost");
      wasUp = false;
      String ssid, pass;
      { Lock l; ssid = cfgSsid; pass = cfgPass; }
      if (!ssid.length()) { setPhase(PH_NOWIFI); setNote("no Wi-Fi set: serial  w ssid,pass"); vTaskDelay(500); continue; }
      if (!wifiStart || millis() - wifiStart > 15000) {
        Serial.printf("[WIFI] connecting to %s\n", ssid.c_str());
        WiFi.disconnect();
        WiFi.begin(ssid.c_str(), pass.c_str());
        static bool scannedOnce = false;
        if (wifiStart) {
          setPhase(PH_NOWIFI); setNote("can't join " + ssid);
          if (!scannedOnce) { scannedOnce = true; scanWifi(ssid); }
        }
        wifiStart = millis();
      }
      vTaskDelay(200);
      continue;
    }
    if (!wasUp) {
      wasUp = true; wifiStart = 0;
      Serial.printf("[WIFI] up, IP %s, RSSI %d\n", WiFi.localIP().toString().c_str(), WiFi.RSSI());
      if (!timeSet) { configTime(0, 0, "pool.ntp.org", "time.google.com"); timeSet = true; }
      setNote("");
      Lock l; wantHello = true;
    }
    if (!nBrain.length()) { setPhase(PH_HELLO); setNote("no brain URL: serial  u https://..."); vTaskDelay(500); continue; }

    bool hello, confirm, talk, stateNow;
    Phase ph;
    {
      Lock l;
      hello = wantHello; confirm = wantConfirm; talk = talkReady; stateNow = wantStateNow; ph = phase;
    }
    uint32_t now = millis();
    if (hello || ph == PH_BOOT || ph == PH_NOWIFI || ((ph == PH_HELLO || ph == PH_LOST) && now - lastHello > 10000)) {
      { Lock l; wantHello = false; }
      lastHello = now;
      if (ph == PH_BOOT || ph == PH_NOWIFI) setPhase(PH_HELLO);
      doHello();
      continue;
    }
    if (ph == PH_PAIRING) {
      if (confirm) { { Lock l; wantConfirm = false; } doConfirm(); continue; }
      if (now - lastPair > 2000) { lastPair = now; pollPairing(); }
    } else if (ph == PH_PET && nRef.length()) {
      if (talk) { { Lock l; talkReady = false; } doTalk(); continue; }
      if (stateNow || now - lastState > 20000) { { Lock l; wantStateNow = false; } lastState = now; pollState(); continue; }
      if (now - lastInbox > 20000 && now - lastState > 5000) { lastInbox = now; pollInbox(); continue; }
      bool haveCare;
      { Lock l; haveCare = !careQ.empty(); }
      if (haveCare && now - lastCare > 30000) { lastCare = now; flushCare(); continue; }
    }
    vTaskDelay(50);
  }
}

