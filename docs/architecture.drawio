<mxfile host="app.diagrams.net"><diagram id="petto-arch" name="Architecture"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Petto architecture&lt;/b&gt; (NEAR testnet)&lt;br&gt;&lt;font style='font-size:11px'&gt;An AI pet NFT that pays for its own private AI. Arrows point from caller to callee; red dashed = money or credit.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Clients" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="490" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Owner's wallet&lt;/b&gt;&lt;br&gt;NEAR Connect (Meteor, HOT, ...) or Privy email / Google&lt;br&gt;signs value transactions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Web app&lt;/b&gt; (Next.js)&lt;br&gt;Home · Talk · Feed · Garden · Closet · Shop · Soul · Race · public pet page" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="220" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Petto device&lt;/b&gt; (ESP32-S3)&lt;br&gt;screen, buttons, touch, motion + light sensors, mic, speaker&lt;br&gt;hold to talk · offline care · Closet · Petto Run · hold-to-approve&lt;br&gt;&lt;i&gt;limited key: play, feed_from_pantry, approve_action&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="220" height="170" as="geometry"/></mxCell><mxCell id="c7" value="Brain service (Node 22, Hono, SQLite)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=3;fillColor=#f8f8ff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="420" height="490" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Talk + receipts&lt;/b&gt;&lt;br&gt;Soul from chain + memory; TEE attestation, signed request / response hashes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="185" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Memory + inbox&lt;/b&gt;&lt;br&gt;AES-256-GCM per pet; the pet messages first" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="655" y="150" width="165" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Fuel queue&lt;/b&gt;&lt;br&gt;1 reply = 1 charge; idempotent usage_ref" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="185" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Feed the Brain&lt;/b&gt;&lt;br&gt;orders, feed tx check, feeder account" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="655" y="260" width="165" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Pairing, care, Closet&lt;/b&gt;&lt;br&gt;device tokens, costumes, wallet approvals" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="355" width="185" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Race server&lt;/b&gt;&lt;br&gt;Petto Run rooms over WebSocket" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="655" y="355" width="165" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Gas relay (NEP-366)&lt;/b&gt;&lt;br&gt;pays gas for no-deposit calls; name.testnet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="185" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;NFT metadata&lt;/b&gt;&lt;br&gt;pet PNG + JSON on IPFS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="655" y="450" width="165" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Scheduler&lt;/b&gt;: proactive messages (15 min), sweep_credit (hourly)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="545" width="380" height="40" as="geometry"/></mxCell><mxCell id="c17" value="NEAR testnet" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=3;fillColor=#f0faf0;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="460" height="490" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;pets.petto.testnet&lt;/b&gt; (+ pets-demo.petto.testnet at 100x speed)&lt;br&gt;Pet NFT (NEP-171/177/181) · fuel = food + staking credit · capped charge · Soul · hatch and XP stages · pantry · device approvals · NEP-297 events" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="420" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;shirts.petto.testnet&lt;/b&gt;&lt;br&gt;free shirt + 36 costumes (0.05 NEAR), NEP-171" style="rounded=1;