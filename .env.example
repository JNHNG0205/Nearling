# Copy to .env. Names only, never commit values (CLAUDE.md rule 3).
# Full list and meaning: AI-brain architectual/01-overview.md section 7

# chain (testnet only)
NEAR_NETWORK=testnet
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
PETS_CONTRACT=pets-v8.nearling.testnet
DEMO_PETS_CONTRACT=pets-demo.nearling.testnet
SHIRTS_CONTRACT=shirts.nearling.testnet
NEARON_POOL=mw-pool-1024.testnet
BRAIN_ACCOUNT_ID=
BRAIN_KEYS=
FEEDER_ACCOUNT_ID=
FEEDER_KEY=
FEEDER_DAILY_CAP_NEAR=10
WALLET_VALIDATOR_POOL=legends.pool.f863973.m0

# NEAR AI (staging)
NEARAI_BASE_URL=https://cloud-stg-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_CHAT_MODEL=z-ai/glm-5.3-flash
NEARAI_STT_MODEL=openai/whisper-large-v3

# voice
TTS_PROVIDER=none
TTS_MODEL=eleven_flash_v2_5
TTS_API_KEY=
TTS_VOICE_ID=
# kokoro fallback only
TTS_BASE_URL=http://localhost:8880/v1

# brain
PORT=8787
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
MEMORY_MASTER_KEY=
SESSION_JWT_SECRET=
GLOBAL_DAILY_SPEND_CAP_USD=5
INTENTS_MODE=direct
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
SETTLEMENT_ACCOUNT_MAINNET=
# Human only (CLAUDE.md rule 1): 1 allows non-dry 1Click quotes, i.e. real mainnet deposits
INTENTS_LIVE_CONFIRMED=0
MOCK_AI=0

# ops (AI-brain 09 section 3)
# ElevenLabs Flash v2.5 USD per 1,000 characters for the spend cap [VERIFY our plan's price]
TTS_USD_PER_1K_CHARS=0.05
# NEAR AI org read after credit sweeps; empty = the pets contract config().org_id
NEARAI_ORG_ID=
# GET /ops basic auth; /ops is 404 while either is empty
OPS_USER=
OPS_PASSWORD=
# Discord or Slack incoming webhook for log.alert lines (ids only, rate limited)
ALERT_WEBHOOK_URL=
BACKUP_DIR=./data/backups

# web (Next.js reads NEXT_PUBLIC_* from web/.env.local)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_PETS_CONTRACT=pets-v8.nearling.testnet
NEXT_PUBLIC_DEMO_PETS_CONTRACT=pets-demo.nearling.testnet
NEXT_PUBLIC_SHIRTS_CONTRACT=shirts.nearling.testnet
NEXT_PUBLIC_BRAIN_URL=http://localhost:8787

# contract deploy scripts (scripts/deploy-testnet.sh, seed-demo.sh)
NEAR_PARENT_ACCOUNT=    # funds and owns pets-vN.<parent>; also the contract admin
PETS_VERSION=           # bump on every breaking state change (CLAUDE.md 7)
BRAIN_ACCOUNT=          # only account allowed to charge/credit (same as BRAIN_ACCOUNT_ID)
TREASURY_ACCOUNT=       # receives mint storage, item prices, spent food
NEAR_AI_ORG_ID=         # brain's NEAR AI org, lowercase UUID (CREDIT sweep target)
