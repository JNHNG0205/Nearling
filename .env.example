# Contract (Role 1). Copy to .env and fill in. Never commit .env.
NEAR_PARENT_ACCOUNT=yourteam.testnet      # funds and owns pets-vN.<parent>; also the contract admin
PETS_VERSION=1                            # bump on every breaking state change (CLAUDE.md 7)
BRAIN_ACCOUNT=brain.yourteam.testnet      # only account allowed to charge/credit
TREASURY_ACCOUNT=yourteam.testnet         # receives mint storage, item prices, spent food
NEARON_POOL=mw-pool-1024.testnet
NEAR_AI_ORG_ID=00000000-0000-0000-0000-000000000000   # brain's NEAR AI org, lowercase UUID
PETS_CONTRACT=pets-v1.yourteam.testnet    # read by brain, web and firmware
