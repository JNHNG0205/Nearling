# Copy to .env and fill in. Never commit .env.
NEAR_PARENT_ACCOUNT=    # funds and owns pets-vN.<parent>; also the contract admin
PETS_VERSION=                      # bump on every breaking state change (CLAUDE.md 7)
BRAIN_ACCOUNT=    # only account allowed to charge/credit
TREASURY_ACCOUNT=       # receives mint storage, item prices, spent food
NEARON_POOL=
NEAR_AI_ORG_ID=  # brain's NEAR AI org, lowercase UUID
PETS_CONTRACT=   # read by brain, web and firmware