# Copy to .env. Names only, never commit values (CLAUDE.md rule 3).
# Full list and meaning: AI-brain architectual/01-overview.md section 7

# chain (testnet only)
NEAR_NETWORK=testnet
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
PETS_CONTRACT=pets-v8.nearling.testnet
DEMO_PETS_CONTRACT=pets-demo.nearling.testnet
SHIRTS_CONTRACT=shirts.nearling.testnet
NEARON_POOL=mw-pool-1024.testnet
BRAIN_ACCOUNT_ID=
BRAIN_KEYS=
FEEDER_ACCOUNT_ID=
FEEDER_KEY=

# NEAR AI (staging)
NEARAI_BASE_URL=https://cloud-stg-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_CHAT_MODEL=z-ai/glm-5.3-flash
NEARAI_STT_MODEL=openai/whisper-large-v3

# voice
TTS_PROVIDER=none
TTS_MODEL=eleven_flash_v2_5
TTS_API_KEY=
TTS_VOICE_ID=

# brain
PORT=8787
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
MEMORY_MASTER_KEY=
SESSION_JWT_SECRET=
GLOBAL_DAILY_SPEND_CAP_USD=5
INTENTS_MODE=direct
MOCK_AI=0

# web (Next.js reads NEXT_PUBLIC_* from web/.env.local)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_PETS_CONTRACT=pets-v8.nearling.testnet
NEXT_PUBLIC_DEMO_PETS_CONTRACT=pets-demo.nearling.testnet
NEXT_PUBLIC_SHIRTS_CONTRACT=shirts.nearling.testnet
NEXT_PUBLIC_BRAIN_URL=http://localhost:8787
